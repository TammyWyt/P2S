        <mxCell id="e_v1_agg" value="attest S1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#3B6EA5;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#3B6EA5;fontSize=10;" edge="1" parent="1" source="b_v1" target="agg">
