        <mxCell id="e_prop_v1" value="S1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07B39;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#E07B39;fontSize=11;" edge="1" parent="1" source="prop" target="a_v1">
