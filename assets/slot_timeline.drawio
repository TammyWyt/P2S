        </mxCell>
        <mxCell id="a_v3" value="V3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="255" y="285" width="52" height="52" as="geometry" />
        </mxCell>

        <!-- ============ Phase 2 nodes ============ -->
        <mxCell id="senders" value="Senders" style="shape=actor;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="100" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="b_v1" value="V1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="95" width="52" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b_v2" value="V2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
