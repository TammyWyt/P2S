<mxfile host="app.diagrams.net" agent="Claude Code">
  <diagram name="P2S slot timeline" id="p2s-slot-timeline">
    <mxGraphModel dx="820" dy="480" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="300" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== swimlane bands (soft fills, no stroke) ===== -->
        <mxCell id="lane-user" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="80" y="38" width="720" height="72" as="geometry" />
        </mxCell>
        <mxCell id="lane-prop" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="80" y="112" width="720" height="72" as="geometry" />
        </mxCell>
        <mxCell id="lane-chain" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=none;" value="" vertex="1">
          <mxGeometry x="80" y="186" width="720" height="96" as="geometry" />
        </mxCell>

        <!-- ===== lane labels (bold) ===== -->
        <mxCell id="lbl-user" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" value="User" vertex="1">
          <mxGeometry x="8" y="65" width="66" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lbl-prop" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" value="Proposer" vertex="1">
          <mxGeometry x="8" y="139" width="66" height="18" as="geometry" />
        </mxCell>
        <mxCell id="lbl-chain" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;" value="Chain" vertex="1">
          <mxGeometry x="8" y="225" width="66" height="18" as="geometry" />
        </mxCell>

        <!-- ===== phase headers ===== -->
        <mxCell id="h-a" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;fontColor=#555555;" value="Step 1 &#183; 0&#8211;4 s" vertex="1">
          <mxGeometry x="80" y="12" width="240" height="18" as="geometry" />
        </mxCell>
        <mxCell id="h-b" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;fontColor=#555555;" value="Reveal + Attest &#183; 4&#8211;8 s" vertex="1">
          <mxGeometry x="320" y="12" width="240" height="18" as="geometry" />
        </mxCell>
        <mxCell id="h-c" parent="1" style="text;html=1;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontStyle=1;fontSize=13;fontColor=#555555;" value="Step 2 &#183; 8&#8211;12 s" vertex="1">
          <mxGeometry x="560" y="12" width="240" height="18" as="geometry" />
        </mxCell>

        <!-- ===== phase dividers (dashed) ===== -->
        <mxCell id="div1" parent="1" style="endArrow=none;html=1;dashed=1;strokeColor=#B3B3B3;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="320" y="36" as="sourcePoint" />
            <mxPoint x="320" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="div2" parent="1" style="endArrow=none;html=1;dashed=1;strokeColor=#B3B3B3;" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="36" as="sourcePoint" />
            <mxPoint x="560" y="282" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- ===== nodes ===== -->
        <mxCell id="uA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#ffffff;fontSize=13;" value="Submit \(PHT\)&lt;br&gt;(intent hidden)" vertex="1">
          <mxGeometry x="140" y="52" width="120" height="44" as="geometry" />
        </mxCell>
        <mxCell id="pA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#ffffff;fontSize=13;" value="Order \(PHT\)s,&lt;br&gt;build \(S_1\)" vertex="1">
          <mxGeometry x="140" y="126" width="120" height="44" as="geometry" />
        </mxCell>
        <mxCell id="cA" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#ffffff;fontSize=13;" value="Attest \(S_1\)&lt;br&gt;(order fixed, only vote)" vertex="1">
          <mxGeometry x="132" y="208" width="136" height="48" as="geometry" />
        </mxCell>
        <mxCell id="uB" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#ffffff;fontSize=13;" value="Reveal \(MT\)&lt;br&gt;(open commitment)" vertex="1">
          <mxGeometry x="378" y="52" width="124" height="44" as="geometry" />
        </mxCell>
        <mxCell id="cB" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#ffffff;fontSize=13;" value="Collect \(E\);&lt;br&gt;aggregate attestations" vertex="1">
          <mxGeometry x="372" y="208" width="136" height="48" as="geometry" />
        </mxCell>
        <mxCell id="cC" parent="1" style="rounded=1;whiteSpace=wrap;html=1;absoluteArcSize=1;arcSize=14;strokeWidth=2;fillColor=#ffffff;fontSize=13;" value="Close \(E\); each validator forms&lt;br&gt;\(S_2 = f(B_0, S_1, E)\) locally&lt;br&gt;(no new vote)" vertex="1">
          <mxGeometry x="592" y="202" width="176" height="60" as="geometry" />
        </mxCell>

        <!-- ===== cross-lane messages (labeled) ===== -->
        <mxCell id="e-uA-pA" parent="1" source="uA" target="pA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="submit \(PHT\)" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-pA-cA" parent="1" source="pA" target="cA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="gossip \(S_1\)" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-uB-cB" parent="1" source="uB" target="cB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" value="reveal \(MT\)" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ===== chain-lane progression (unlabeled) ===== -->
        <mxCell id="e-cA-cB" parent="1" source="cA" target="cB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cB-cC" parent="1" source="cB" target="cC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" value="" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
