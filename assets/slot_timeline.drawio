<mxfile host="app.diagrams.net" type="device">
  <diagram name="P2S slot timeline" id="p2s-slot-timeline">
    <mxGraphModel dx="1100" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ Phase group containers (drawn first = behind) ============ -->
        <mxCell id="g1" value="Step 1&#10;0&#8211;4 s" style="rounded=1;dashed=1;fillColor=none;strokeColor=#9AA7B0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1A7F8E;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="320" height="350" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="Reveal + Attest&#10;4&#8211;8 s" style="rounded=1;dashed=1;fillColor=none;strokeColor=#9AA7B0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1A7F8E;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="320" height="350" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="Step 2&#10;8&#8211;12 s" style="rounded=1;dashed=1;fillColor=none;strokeColor=#9AA7B0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#1A7F8E;" vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="380" height="350" as="geometry" />
        </mxCell>

        <!-- inner "local, no vote" box in Step 2 -->
        <mxCell id="localbox" value="formed locally &#183; no proposal or vote" style="rounded=1;dashed=1;fillColor=none;strokeColor=#E07B39;verticalAlign=top;align=center;spacingTop=4;fontSize=10;fontColor=#E07B39;" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="200" height="300" as="geometry" />
        </mxCell>

        <!-- ============ Phase 1 nodes ============ -->
        <mxCell id="pool" value="PHT pool" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#DEEBF7;strokeColor=#3B6EA5;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="55" y="100" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="prop" value="Proposer&#10;(agent)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6C4A9C;strokeColor=#4A2E75;fontColor=#FFFFFF;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="250" width="120" height="60" as="geometry" />
