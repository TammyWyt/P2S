        <!-- ============ Phase 2 edges ============ -->
        <mxCell id="e_s_v1" value="MT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07B39;strokeWidth=1.5;endArrow=block;endFill=1;fontColor=#E07B39;fontSize=11;" edge="1" parent="1" source="senders" target="b_v1">
          <mxGeometry relative="1" as="geometry" />
