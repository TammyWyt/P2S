        <!-- ============ caption ============ -->
        <mxCell id="cap" value="P2S slot: three per-phase snapshots within Ethereum's unchanged 12-second schedule. Only S1 is proposed and attested; reveals and attestations flow in parallel; S2 is a local, deterministic completion needing no further vote." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#1A7F8E;" vertex="1" parent="1">
          <mxGeometry x="40" y="405" width="1020" height="40" as="geometry" />
