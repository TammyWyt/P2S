        <!-- ============ Phase 1 edges ============ -->
        <mxCell id="e_pool_prop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#E07B39;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="pool" target="prop">
